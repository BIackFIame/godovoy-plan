[Unit]
Description=Godovoy Plan office HTTPS
Wants=godovoy-quick-calendar.service
After=network.target godovoy-quick-calendar.service

[Service]
Type=exec
User=godovoy-tls
Group=godovoy-tls
SupplementaryGroups=godovoy-office
EnvironmentFile=/etc/godovoy-quick/office.env
Environment=XDG_DATA_HOME=/var/lib/godovoy-tls XDG_CONFIG_HOME=/var/lib/godovoy-tls
StateDirectory=godovoy-tls
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/caddy run --config /etc/godovoy-quick/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
